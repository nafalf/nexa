<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin — Nexa</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="layout"><%-include('partials/nav')%><main class="content"><header class="page-top"><div><small class="muted">Ruang kendali</small><h1>Admin dashboard</h1></div></header><div class="quick-grid"><div class="card"><small>Pengguna</small><h2><%=users%></h2></div><div class="card"><small>Transaksi</small><h2><%=transactions%></h2></div><div class="card"><small>Alert</small><h2><%=alerts.length%></h2></div></div><section class="card"><h3>Fraud alert</h3><%alerts.forEach(a=>{%><div class="transaction"><span><b><%=a.description%></b><small>Nominal tinggi · <%=a.created_at%></small></span><strong class="debit">Rp<%=Number(a.amount).toLocaleString('id-ID')%></strong></div><%})%></section></main></div></body></html>
