<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Beranda — Nexa</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="layout"><%-include('partials/nav')%><main class="content"><header class="page-top"><div><small class="muted">Selamat pagi</small><h1>Hai, <%=user.name.split(' ')[0]%>.</h1></div><div class="avatar"><%=user.name[0]%></div></header><section class="content-grid"><div><div class="balance-card"><span class="pill">UTAMA</span><small>Nexa Tabungan · <%=account.number%></small><strong>Rp<%=Number(account.balance).toLocaleString('id-ID')%></strong><span>Saldo tersedia</span></div><div class="section-title"><h2>Akses cepat</h2></div><div class="quick-grid"><a href="/transfer"><b>Transfer</b><span>Kirim dana</span></a><a href="/activity"><b>Aktivitas</b><span>Riwayat transaksi</span></a><a href="/profile"><b>Rekening</b><span>Detail akun</span></a></div><div class="section-title"><h2>Transaksi terakhir</h2><a href="/activity">Lihat semua</a></div><section class="card"><%transactions.forEach(t=>{%><div class="transaction"><div><b><%=t.description%></b><small><%=t.created_at%></small></div><strong class="debit">- Rp<%=Number(t.amount).toLocaleString('id-ID')%></strong></div><%})%></section></div><aside class="side-card"><h3>Ringkasan bulan ini</h3><p class="muted">Pengeluaran</p><strong class="big">Rp1.250.000</strong><hr><p class="muted">Status akun</p><strong>Aktif</strong></aside></section></main></div></body></html>
