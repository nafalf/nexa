<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Aktivitas — Nexa</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="layout"><%-include('partials/nav')%><main class="content"><header class="page-top"><div><small class="muted">Catatan keuangan</small><h1>Aktivitas</h1></div></header><section class="card wide"><p class="muted">Semua transaksi rekening kamu.</p><%transactions.forEach(t=>{%><div class="transaction"><div><b><%=t.description%></b><small><%=t.created_at%> · <%=t.status%></small></div><strong class="debit">- Rp<%=Number(t.amount).toLocaleString('id-ID')%></strong></div><%})%></section></main></div></body></html>
