<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Rekening Tujuan — Nexa</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="layout"><%-include('partials/nav')%><main class="content"><header class="page-top"><div><small class="muted">Kelola transfer</small><h1>Rekening tujuan</h1></div></header><section class="content-grid"><section class="card form-card"><h3>Tambah rekening</h3><form method="post" action="/beneficiaries"><label>Nama penerima<input name="name" required></label><label>Bank<input name="bank" required></label><label>Nomor rekening<input name="number" required></label><button class="primary">Simpan rekening</button></form></section><section class="card"><h3>Daftar tersimpan</h3><%beneficiaries.forEach(b=>{%><div class="transaction"><div><b><%=b.name%></b><small><%=b.bank%> · <%=b.number%></small></div><span>Aktif</span></div><%})%></section></section></main></div></body></html>
